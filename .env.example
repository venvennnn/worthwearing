# Environment template for WorthWearing
# Copy to .env and fill secrets locally. Never commit real keys.

DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Perfect Corp YouCam Online Editor (server-side only)
PERFECT_CORP_API_KEY=
PERFECT_CORP_BASE_URL=https://yce-api-01.makeupar.com
# Official AI Clothes v4 create path. Payload mapping lives in
# backend/app/providers/perfect_corp.py (_build_try_on_payload).
PERFECT_CORP_TRYON_PATH=/s2s/v2.0/task/cloth-v4
# Official status path. {task_id} is substituted, or /{task_id} is appended.
PERFECT_CORP_STATUS_PATH=/s2s/v2.0/task/cloth-v4/{task_id}
# Optional Image Generator. UI disables live scenario generation when blank/unconfigured.
PERFECT_CORP_IMAGE_GENERATOR_PATH=/s2s/v2.0/task/image-to-image/youcam

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
